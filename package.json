{
  "name": "tripsplit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx scripts/test.ts",
    "eval": "tsx scripts/eval.ts",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:preview": "node scripts/cf-build.mjs && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/cf-build.mjs && opennextjs-cloudflare deploy && npm run cf:pages",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:pages": "cd cf-pages && wrangler pages deploy --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@libsql/client": "^0.18.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.159.0"
  }
}
